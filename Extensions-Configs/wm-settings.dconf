[keybindings]
maximize=['<Super>Up']
move-to-workspace-down=['<Control><Shift><Alt>Down']
move-to-workspace-left=['<Super><Shift>KP_Prior', '<Super><Shift><Alt>Left', '<Control><Shift><Alt>Left', '<Super><Shift>Page_Up']
move-to-workspace-right=['<Super><Shift>KP_Next', '<Super><Shift><Alt>Right', '<Control><Shift><Alt>Right', '<Super><Shift>Page_Down']
move-to-workspace-up=['<Control><Shift><Alt>Up']
show-desktop=['<Super>d']
switch-applications=['<Alt>Tab']
switch-applications-backward=['<Shift><Alt>Tab']
switch-to-workspace-down=['<Control><Alt>Down']
switch-to-workspace-left=['<Super>KP_Prior', '<Super><Alt>Left', '<Control><Alt>Left', '<Super>Page_Up']
switch-to-workspace-right=['<Super>KP_Next', '<Super><Alt>Right', '<Control><Alt>Right', '<Super>Page_Down']
switch-to-workspace-up=['<Control><Alt>Up']
switch-windows=@as []
switch-windows-backward=@as []
unmaximize=['<Super>Down', '<Alt>F5']

[preferences]
action-middle-click-titlebar='none'
auto-raise=false
button-layout='close:appmenu'
focus-mode='mouse'
resize-with-right-button=true
theme='MacTahoe-Dark'
